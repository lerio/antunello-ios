# Expo public variables. These are embedded in the app bundle, so anything here
# is readable by anyone with the app. Nothing secret goes in this file.

# The Supabase project — the same one the web app uses.
# Copy the values from ../antunello-app/.env.local
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The deployed web app. Used to open the bank-connection settings page in an
# in-app browser, since those flows depend on a server-side private key that
# cannot ship in a phone app.
EXPO_PUBLIC_WEB_URL=https://antunello-app.vercel.app

# Deliberately absent, and must never be added here:
#   SUPABASE_SERVICE_ROLE_KEY      — bypasses row-level security
#   ENABLE_BANKING_PRIVATE_KEY     — signs bank API requests
#   CRON_SECRET                    — authorises the sync endpoint
